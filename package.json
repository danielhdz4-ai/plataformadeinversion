    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @pi/roi-engine test",
    "db:apply": "node scripts/db-apply.mjs",
    "scrape:barcelona": "node --env-file=.env.local scripts/jobs/scrape-bcn-metro.mjs",
    "scrape:bcn-metro": "node --env-file=.env.local scripts/jobs/scrape-bcn-metro.mjs",
    "scrape:madrid-districts": "node --env-file=.env.local scripts/jobs/scrape-madrid-districts.mjs",
    "scrape:city-districts": "node --env-file=.env.local scripts/jobs/scrape-city-districts.mjs",
    "scrape:districts-rotate": "node --env-file=.env.local scripts/jobs/scrape-districts-rotate.mjs",
    "enrich:zone-centers": "node scripts/ops/enrich-zone-centers.mjs all",
    "thumbnails:backfill": "node --env-file=.env.local scripts/jobs/backfill-thumbnails.mjs",
    "geocode:kelify": "node --env-file=.env.local scripts/jobs/geocode-kelify-listings.mjs",
